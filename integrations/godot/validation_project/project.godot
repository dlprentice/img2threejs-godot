; Engine configuration file.
; This project is intentionally isolated from every game repository.

config_version=5

[application]

config/name="Asset Forge Godot Validation"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.045, 0.055, 0.07, 1)
